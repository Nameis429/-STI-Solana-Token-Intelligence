{
  "schema_version": "2.0.0",
  "phase": 9,
  "engine": "Risk Engine",
  "config_version": "2.0.0",
  "description": "Phase 9 v2 rule catalog. Statuses are evidence-based; missing/partial coverage is never treated as absence. Thresholds are inherited unless explicitly documented.",
  "settings": {
    "timezone": "Asia/Jakarta",
    "enabled_statuses": [
      "TRIGGERED",
      "PROVISIONAL",
      "NOT_TRIGGERED",
      "UNKNOWN",
      "INSUFFICIENT_DATA",
      "DISABLED"
    ],
    "fail_on_invalid_config": true,
    "disabled_rule_status": "DISABLED",
    "require_evidence_refs_for_triggered": true,
    "deduplicate_evidence": true,
    "do_not_score_in_phase9": true,
    "deduplication_policy": {
      "event_identity": [
        "signature",
        "wallet_id",
        "token_mint",
        "event_class"
      ],
      "sequence_identity": [
        "transfer_signature",
        "recipient_wallet",
        "sell_signature",
        "token_mint"
      ],
      "count_unique_transactions_not_repeated_evidence_refs": true,
      "prevent_one_transfer_from_pairing_with_multiple_sell_events_without_distinct_sequence": true
    },
    "evaluation_policy": {
      "primary_status": "TRIGGERED",
      "alternative_status": "PROVISIONAL",
      "provisional_requires_explicit_rule_alternative": true,
      "do_not_downgrade_structural_data_gaps_by_lowering_numeric_thresholds": true,
      "missing_or_partial_data_must_not_be_treated_as_NOT_TRIGGERED": true,
      "transfer_is_not_sell": true,
      "holder_concentration_is_not_trading_concentration": true,
      "selected_wallet_sample_is_not_market_wide_volume": true,
      "version": "2.0.0",
      "triggered_requires_rule_specific_evidence": true,
      "provisional_requires_enabled_alternative_and_valid_evidence": true,
      "all_configured_rules_must_be_returned": true
    }
  },
  "categories": {
    "SELL_PRESSURE_RISK": {
      "enabled": true,
      "rules": {
        "SPR-01": {
          "enabled": true,
          "name": "Large Holder Sell Ratio",
          "description": "Sell amount relative to wallet balance immediately before the sell.",
          "metric": "sell_amount / balance_before_sell",
          "threshold": 0.2,
          "operator": ">=",
          "unit": "ratio",
          "required_data": [
            "verified_sell_amount",
            "historical_balance_before_sell"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "window_seconds": null,
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "SPR-01",
          "status_on_missing_data": "INSUFFICIENT_DATA",
          "evidence_contract": {
            "implemented": "2026-10-11",
            "evaluator": "evaluateSpr01 in Script/phase9_risk_engine.js",
            "required_data": [
              "per-wallet ordered SELL events with verified amount_raw",
              "balance_before_sell reconstructed from the same wallet's observed ledger"
            ],
            "ledger_discipline": "history.complete===true AND BUY+RECEIVE-SELL-TRANSFER_OUT===current balance (exact); failing wallets are EXCLUDED, never negative evidence",
            "counting_unit": "unique SELL events deduplicated by event_id",
            "metric": "sell_ratio = sell_amount / balance_before_sell",
            "threshold_source": "rule.threshold (0.2); fallback rule.thresholds.sell_ratio then 0.5",
            "exclusions": [
              "LIQUIDITY_POOL wallets",
              "SELF_TRANSFER nets to zero",
              "any unverifiable amount invalidates that wallet"
            ],
            "statuses": {
              "TRIGGERED": ">=1 qualifying SELL",
              "NOT_TRIGGERED": "evaluated wallets exist, none qualify",
              "INSUFFICIENT_DATA": "no reconcilable wallet ledger"
            }
          }
        },
        "SPR-02": {
          "enabled": true,
          "name": "Repeated Sell Activity",
          "description": "Count verified SELL events by one wallet within the configured window.",
          "metric": "verified_sell_event_count",
          "min_count": 5,
          "window_seconds": 3600,
          "required_data": [
            "verified_sell_events",
            "timestamps",
            "wallet_id",
            "complete_window_coverage",
            "unique_transaction_or_event_identity",
            "verified_sell_classification"
          ],
          "initial_eligibility": "CONDITIONAL",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": true,
              "status": "PROVISIONAL",
              "threshold": {
                "min_unique_sell_events": 3,
                "window_seconds": 3600
              },
              "note": "PROVISIONAL hanya jika minimal 3 event SELL unik/terverifikasi dalam window 1 jam; event wajib dideduplikasi. Ambang awal untuk pengujian, bukan bukti risiko pasar secara luas."
            }
          },
          "evaluator": "SPR-02",
          "status_on_missing_data": "INSUFFICIENT_DATA"
        },
        "SPR-03": {
          "enabled": true,
          "name": "Connected Wallet Sell Volume Share",
          "description": "Connected wallets' sell volume divided by total token trading volume for the same interval.",
          "metric": "connected_wallet_sell_volume / total_trading_volume",
          "threshold": 0.05,
          "operator": ">=",
          "unit": "ratio",
          "required_data": [
            "verified_wallet_relationships",
            "connected_wallet_sell_volume",
            "total_trading_volume",
            "matching_period_and_units"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "SPR-03",
          "status_on_missing_data": "INSUFFICIENT_DATA"
        },
        "SPR-04": {
          "enabled": true,
          "name": "Holder Balance Reduction Attributable to Sells",
          "description": "Verified sell-attributed balance reduction relative to balance at period start.",
          "metric": "sell_attributed_balance_reduction / period_start_balance",
          "threshold": 0.2,
          "operator": ">=",
          "unit": "ratio",
          "required_data": [
            "historical_balances",
            "verified_sell_events",
            "event_attribution"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "SPR-04",
          "status_on_missing_data": "INSUFFICIENT_DATA",
          "evidence_contract": {
            "implemented": "2026-10-11",
            "evaluator": "evaluateSpr04 in Script/phase9_risk_engine.js",
            "ledger_discipline": "same as SPR-01: complete + reconciled + LP excluded",
            "metric": "total_sell_volume / peak_reconstructed_balance (period_start_balance proxied by peak; documented)",
            "threshold_source": "rule.threshold (0.2)",
            "counting_unit": "wallet",
            "statuses": {
              "TRIGGERED": ">=1 wallet >= threshold",
              "NOT_TRIGGERED": "evaluated, none qualify",
              "INSUFFICIENT_DATA": "no reconcilable ledger"
            }
          }
        },
        "SPR-05": {
          "enabled": true,
          "name": "Sell Volume Relative to Liquidity",
          "description": "Sell volume divided by relevant pool liquidity, with aligned time and valuation units.",
          "metric": "sell_volume / pool_liquidity",
          "threshold": 0.05,
          "operator": ">=",
          "unit": "ratio",
          "required_data": [
            "verified_sell_volume",
            "historical_pool_liquidity",
            "pool_mapping",
            "consistent_valuation_units"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "SPR-05",
          "status_on_missing_data": "INSUFFICIENT_DATA",
          "evidence_contract": {
            "implemented": "2026-10-11",
            "evaluator": "evaluateSellVsLiquidity in Script/phase9_risk_engine.js",
            "required_data": [
              "verified SELL events (bounded sample)",
              "Phase 4 liquidity_snapshot.base (scan-time proxy, not historical series)"
            ],
            "metric": "total observed SELL volume / pool base-token balance (raw units both sides)",
            "threshold_source": "rule.threshold (0.05)",
            "counting_unit": "total unique observed SELL volume",
            "statuses": {
              "TRIGGERED": "ratio >= threshold",
              "NOT_TRIGGERED": "sells observed, below threshold",
              "INSUFFICIENT_DATA": "no usable pool snapshot or no verifiable sells"
            }
          }
        }
      }
    },
    "COORDINATED_TRADING_RISK": {
      "enabled": true,
      "rules": {
        "CTR-01": {
          "enabled": true,
          "name": "Multi-Wallet Trading Activity",
          "description": "Trading activity among at least the configured number of directly linked wallets.",
          "min_wallets": 2,
          "min_trades": 2,
          "window_seconds": 86400,
          "required_data": [
            "verified_wallet_relationships",
            "verified_trade_events",
            "timestamps"
          ],
          "initial_eligibility": "CONDITIONAL",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "CTR-01",
          "status_on_missing_data": "INSUFFICIENT_DATA",
          "evidence_contract": {
            "implemented": "2026-10-11",
            "evaluator": "evaluateCtr01 in Script/phase9_risk_engine.js",
            "required_data": [
              "funding-graph.json shared_funders (Phase 8B collector)",
              "observed BUY/SELL per wallet"
            ],
            "metric": "shared funder linking >= min_wallets (default 2) active wallets",
            "counting_unit": "shared_funder",
            "caveat": "shared funder (esp. CEX) does not prove common ownership \u2014 investigative lead only"
          }
        },
        "CTR-02": {
          "enabled": true,
          "name": "Funding-to-Trading Relationship",
          "description": "A wallet with a verified funding relationship trades within the configured time after funding.",
          "window_seconds": 86400,
          "required_data": [
            "verified_funding_relationship",
            "funding_timestamp",
            "recipient_wallet",
            "verified_trade_event"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "CTR-02",
          "status_on_missing_data": "INSUFFICIENT_DATA",
          "evidence_contract": {
            "implemented": "2026-10-11",
            "evaluator": "evaluateCtr02 in Script/phase9_risk_engine.js",
            "required_data": [
              "funding-graph.json per-wallet funders with block_time",
              "first observed BUY/SELL per wallet"
            ],
            "metric": "funder->wallet funding at Tf, first trade at Tt, 0 <= Tt-Tf <= window_seconds (86400)",
            "counting_unit": "unique_funder_wallet_sequence",
            "caveat": "temporal association only; funding does not prove control of the trade"
          }
        },
        "CTR-03": {
          "enabled": true,
          "name": "Linked Transfer Followed by Sell",
          "description": "A recipient sells the same token after a traceable transfer within the configured interval.",
          "window_seconds": 86400,
          "required_data": [
            "verified_token_transfer",
            "sender_wallet",
            "recipient_wallet",
            "verified_sell_event",
            "token_mint",
            "timestamps"
          ],
          "initial_eligibility": "CONDITIONAL",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Tidak ada ambang alternatif numerik sampai sequence unik dan relasi transfer\u2192SELL tervalidasi."
            }
          },
          "sequence_validation": {
            "require_transfer_to_recipient_match": true,
            "require_sell_by_same_recipient": true,
            "require_sell_after_transfer": true,
            "same_token_mint_required": true,
            "counting_unit": "unique_transfer_sell_sequence",
            "one_transfer_multiple_sell_pairing": "disallow_unless_each_pair_is_independently_justified"
          },
          "evaluator": "CTR-03",
          "status_on_missing_data": "INSUFFICIENT_DATA"
        },
        "CTR-04": {
          "enabled": true,
          "name": "Connected Group Trading Volume Share",
          "description": "Connected group's trading volume divided by total token trading volume.",
          "metric": "connected_group_trading_volume / total_trading_volume",
          "threshold": 0.1,
          "operator": ">=",
          "unit": "ratio",
          "required_data": [
            "verified_wallet_group",
            "connected_group_trading_volume",
            "total_trading_volume",
            "matching_period_and_units"
          ],
          "initial_eligibility": "INSUFFICIENT_DATA",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Belum diaktifkan; perlu kriteria alternatif yang tervalidasi."
            }
          },
          "evaluator": "CTR-04",
          "status_on_missing_data": "INSUFFICIENT_DATA"
        },
        "CTR-05": {
          "enabled": true,
          "name": "Repeated Linked Trading Events",
          "description": "Count distinct, directly linked trading events in the configured interval.",
          "min_count": 2,
          "window_seconds": 604800,
          "required_data": [
            "verified_linked_events",
            "event_ids",
            "timestamps",
            "deduplication_keys"
          ],
          "initial_eligibility": "CONDITIONAL",
          "evidence_quality": {
            "deduplicate_before_counting": true,
            "require_transaction_identity": true,
            "require_valid_event_class": true,
            "require_timestamps_when_windowed": true
          },
          "evaluation": {
            "primary": {
              "threshold_source": "existing_rule_parameters",
              "status": "TRIGGERED"
            },
            "alternative": {
              "enabled": false,
              "status": "PROVISIONAL",
              "threshold": null,
              "note": "Tidak ada ambang alternatif numerik sampai event/sequence independen dan relasi wallet tervalidasi."
            }
          },
          "sequence_validation": {
            "counting_unit": "unique_linked_event_sequence",
            "deduplicate_by": [
              "event_id",
              "signature",
              "wallet_id",
              "relationship_id"
            ],
            "require_verified_wallet_relationship": true,
            "repeated_evidence_reference_is_not_independent_event": true
          },
          "evaluator": "CTR-05",
          "status_on_missing_data": "INSUFFICIENT_DATA"
        }
      }
    },
